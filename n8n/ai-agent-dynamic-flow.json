            {
              "name": "status",
              "value": "={{ $fromAI(\"status\") }}"
            },
            {
              "name": "dataHora",
              "value": "={{ $fromAI(\"dataHora\") }}"
            },
            {
              "name": "tenantId",
              "value": "={{ $json.tenantId }}"
            }
          ]
        }
      },
