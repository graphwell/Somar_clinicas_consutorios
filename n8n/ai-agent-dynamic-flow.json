        "method": "PATCH",
        "url": "https://synka.somar.ia.br/api/n8n/agenda/cancelar",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ $fromAI(\"id\") }}"
