    {
      "parameters": {
        "name": "tool_book",
        "description": "Cria um novo agendamento. PROIBIDO usar antes do cliente confirmar com SIM. Parâmetros obrigatórios: pacienteTelefone, pacienteNome, dataHora (ISO 8601), profissionalId, servicoId.",
        "method": "POST",
        "url": "https://synka.somar.ia.br/api/n8n/agenda/criar",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "nome",
              "value": "={{ $fromAI(\"pacienteNome\") }}"
            },
            {
              "name": "dataHora",
              "value": "={{ $fromAI(\"dataHora\") }}"
            },
            {
              "name": "pacienteTelefone",
              "value": "={{ $fromAI(\"pacienteTelefone\") || $json.sessionId }}"
            },
            {
              "name": "tenantId",
              "value": "={{ $json.tenantId }}"
            }
          ]
        }
      },
      "id": "tool-book",
      "name": "Ferramenta: Criar Agendamento",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [
        1350,
        480
      ]
