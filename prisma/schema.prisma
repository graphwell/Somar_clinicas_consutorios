generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinica {
  id             String        @id @default(uuid())
  tenantId       String        @unique
  slug           String        @unique @default("clinica-default")
  nome           String
  nicho          NichoType     @default(CLINICA_MEDICA)
  configBranding Json?         // { logoUrl, primaryColor, etc }
  razaoSocial    String?
  cnpj           String?
  endereco       String?
  adminPhone     String?
  botActive      Boolean       @default(true)
  onboardingCompleted Boolean  @default(false)
  multiProfissional   Boolean  @default(false)
  openingTime         String   @default("08:00")
  closingTime         String   @default("18:00")
  workingDays         String   @default("1,2,3,4,5")
  descricao           String?
  instagram           String?
  site                String?
  aceitaPagamento     Boolean  @default(false)
  usuarios       Usuario[]
  pacientes      Paciente[]
  agendamentos   Agendamento[]
  profissionais  Profissional[]
  convenios      ConvenioEmpresa[]
  notificacoes   Notificacao[]
  servicos       Servico[]
  combosUpsell   ComboUpsell[]
  campanhasAviso CampanhaAviso[]
  transacoes     TransacaoFinanceira[]
  repasses       RepasseProfissional[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  whatsappMigrationStatus WhatsappMigrationStatus @default(TRIAL)

  @@map("clinicas")
  planosAssinatura     PlanoAssinatura[]
  integracoes          ClinicIntegration[]
  whatsappInstances    WhatsappInstance[]
  prontuarios          ProntuarioRegistro[]
  odontogramaItens     OdontogramaItem[]
  odontogramaHistorico OdontogramaHistorico[]
  prontuarioTemplates  ProntuarioTemplate[]
  permissoes           PermissaoRole[]
  fichasCliente        FichaCliente[]
  // Vitrine
  categoriasProduto    CategoriaProduto[]
  produtos             Produto[]
  combosproduto        ComboProduto[]
  pedidoItens          PedidoItem[]
  // Antes e Depois
  consentimentos       ConsentimentoImagem[]
  resultadosAntesDepois ResultadoAntesDepois[]
  filaEspera           FilaEspera[]
  // Insumos
  fichasTecnicas       InsumoFichaTecnica[]
  movimentacoesEstoque MovimentacaoEstoque[]
  convites             Convite[]
  // Fechamentos / Feriados
  diasBloqueados       DiaBloqueado[]
  pixConfig            PixConfig?
  resumoConfig         ResumoConfig?
  notificacoesInternas NotificacaoInterna[]
}

enum NichoType {
  CLINICA_MEDICA
  CLINICA_MULTI
  CLINICA_ESTETICA
  SALAO_BELEZA
  BARBEARIA
  FISIOTERAPIA
  ODONTOLOGIA
  NUTRICAO
  OUTRO
}

model Usuario {
  id             String        @id @default(uuid())
  nome           String?
  sobrenome      String?
  telefone       String?
  email          String        @unique
  senhaHash      String?       // null para usuários Google OAuth
  role           String        @default("recepcao") // admin, recepcao, profissional, temporario
  tenantId       String
  profissionalId String?       // preenchido quando role=profissional
  avatarUrl      String?       // base64 data URL da foto de perfil

  // Verificação de email
  emailVerificado Boolean      @default(false)

  // Google OAuth
  googleId       String?       @unique
  googleEmail    String?

  // Acesso temporário
  acessoExpiraEm DateTime?

  // Onboarding
  primeiroAcesso Boolean       @default(true)
  perfilCompleto Boolean       @default(false)
  ativo          Boolean       @default(true)

  clinica              Clinica              @relation(fields: [tenantId], references: [tenantId])
  profissional         Profissional?        @relation(fields: [profissionalId], references: [id])
  notificacoesInternas NotificacaoInterna[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("usuarios")
}

model Paciente {
  id              String        @id @default(uuid())
  nome            String
  telefone        String
  dataNascimento  DateTime?
  convenio        String?
  tipoAtendimento String        @default("particular")
  
  // Stats V2
  totalGasto      Float         @default(0.0)
  ultimaVisita    DateTime?
  contagemVisitas Int           @default(0)

  isSubscriber          Boolean  @default(false)
  profissionalPreferidoId String?
  cpf                   String?   // New field for patient identification
  // Plano de saúde
  carteirinha           String?
  validadeConvenio      String?   // "MM/YYYY" livre, não DateTime
  titularConvenio       String?
  deletedAt             DateTime?

  tenantId        String
  clinica         Clinica       @relation(fields: [tenantId], references: [tenantId])
  agendamentos    Agendamento[]
  assinaturas     AssinaturaCliente[]
  prontuarios     ProntuarioRegistro[]
  alergias        PacienteAlergia[]
  medicamentos    PacienteMedicamento[]
  fichaCliente    FichaCliente?
  // Antes e Depois
  consentimentos  ConsentimentoImagem[]
  resultadosAntesDepois ResultadoAntesDepois[]
  filaEspera      FilaEspera[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("pacientes")
}

model Profissional {
  id           String        @id @default(uuid())
  nome         String
  especialidade String?
  registroProfissional String?
  bio          String?
  fotoUrl      String?
  color        String?       @default("#4a4ae2")
  horariosJson Json?         // Legacy (keep for compatibility if needed)
  ativo        Boolean       @default(true)
  tenantId     String
  // Repasse financeiro
  percentualRepasse Float?   @default(0)
  repasseFixo       Float?   @default(0)
  repasseTipo       String?  @default("percentual") // percentual|fixo
  clinica      Clinica       @relation(fields: [tenantId], references: [tenantId])
  agendamentos Agendamento[]
  escalas      ProfessionalSchedule[]
  servicos     Servico[]     // Many-to-many with services
  usuarios     Usuario[]
  prontuarios  ProntuarioRegistro[]
  convenios    ProfissionalConvenio[]
  repasses     RepasseProfissional[]
  transacoes   TransacaoFinanceira[]
  // Antes e Depois
  consentimentos ConsentimentoImagem[]
  resultadosAntesDepois ResultadoAntesDepois[]
  filaEspera    FilaEspera[]
  movimentacoesEstoque MovimentacaoEstoque[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("profissionais")
}

model ProfessionalSchedule {
  id             String       @id @default(uuid())
  profissionalId String
  diaSemana      Int          // 0-6
  horaInicio     String       // "08:00"
  horaFim        String       // "18:00"
  lunchStart     String?      // "12:00"
  lunchEnd       String?      // "13:00"
  ativo          Boolean      @default(true)
  profissional   Profissional @relation(fields: [profissionalId], references: [id])

  @@unique([profissionalId, diaSemana])
  @@map("professional_schedules")
}

model ConvenioEmpresa {
  id           String   @id @default(uuid())
  nomeConvenio String
  codigo       String?  // Código ANS da operadora
  telefone     String?
  site         String?
  observacoes  String?
  logoUrl      String?
  ativo        Boolean  @default(true)
  tenantId     String
  clinica      Clinica              @relation(fields: [tenantId], references: [tenantId])
  tabelaPrecos ConvenioTabelaPreco[]
  profissionais ProfissionalConvenio[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("convenios_empresa")
}

model ProfissionalConvenio {
  id             String          @id @default(uuid())
  profissionalId String
  convenioId     String
  tenantId       String
  ativo          Boolean         @default(true)
  profissional   Profissional    @relation(fields: [profissionalId], references: [id])
  convenio       ConvenioEmpresa @relation(fields: [convenioId], references: [id])
  createdAt      DateTime        @default(now())

  @@unique([profissionalId, convenioId])
  @@map("profissional_convenios")
}

model ConvenioTabelaPreco {
  id          String          @id @default(uuid())
  convenioId  String
  servicoId   String
  tenantId    String
  preco       Float
  codigoTuss  String?
  ativo       Boolean         @default(true)
  convenio    ConvenioEmpresa @relation(fields: [convenioId], references: [id])
  servico     Servico         @relation(fields: [servicoId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([convenioId, servicoId])
  @@map("convenio_tabela_precos")
}

model NichoConfig {
  id                 String   @id @default(uuid())
  nomeNicho          String   @unique
  labelCliente       String   @default("Cliente")
  labelServico       String   @default("Serviço")
  labelProfissional  String   @default("Profissional")
  servicosPadraoJson Json?    // Array of default services

  @@map("nichos_config")
}

model Agendamento {
  id              String        @id @default(uuid())
  pacienteId      String
  profissionalId  String?
  dataHora        DateTime      // Início
  fimDataHora     DateTime      // Fim (Início + duration)
  durationMinutes Int           @default(30)
  status          StatusAgendamento @default(pendente)
  eventoId        String        @unique 
  categoria       String?       @default("consulta") // primeira, consulta, retorno
  convenio        String?
  tipoAtendimento String        @default("particular")
  tenantId        String
  clinica         Clinica       @relation(fields: [tenantId], references: [tenantId])
  paciente        Paciente      @relation(fields: [pacienteId], references: [id])
  profissional    Profissional? @relation(fields: [profissionalId], references: [id])
  servicoId       String?
  servico         Servico?      @relation(fields: [servicoId], references: [id])
  
  observacoes     String?
  tipoPagamento   String?  @default("hora")     // hora | total | sinal
  origemAgendamento String? @default("interno") // interno | link_publico | bot
  lembreteEnviado Boolean   @default(false)
  confirmedAt     DateTime?
  confirmedBy     String?   // whatsapp | recepcao | sistema
  transacao       TransacaoFinanceira?

  pedidoItens     PedidoItem[]
  movimentacoes   MovimentacaoEstoque[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("agendamentos")
}

model TransacaoFinanceira {
  id             String       @id @default(uuid())
  tenantId       String
  tipo           String       @default("income") // income, expense
  status         String       @default("pending") // pending, paid, canceled
  valor          Float        @default(0.0)
  descricao      String?
  categoria      String?      @default("Geral")
  agendamentoId  String?      @unique
  // Novos campos financeiros
  formaPagamento String?      // pix|dinheiro|cartao_debito|cartao_credito|convenio|boleto
  parcelas       Int?         @default(1)
  contaBancaria  String?
  profissionalId String?
  convenioId     String?      // referência ao convênio (sem FK para flexibilidade)
  observacao     String?
  dataVencimento DateTime?
  dataPagamento  DateTime?
  numeroRecibo   String?      // REC-YYYYMM-SEQ

  clinica        Clinica      @relation(fields: [tenantId], references: [tenantId])
  agendamento    Agendamento? @relation(fields: [agendamentoId], references: [id])
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("transacoes_financeiras")
}

model RepasseProfissional {
  id             String       @id @default(uuid())
  tenantId       String
  profissionalId String
  periodo        String       // "2026-03" (ano-mes)
  totalBruto     Float        @default(0)
  percentual     Float        @default(0)
  totalRepasse   Float        @default(0)
  status         String       @default("pendente") // pendente|pago|cancelado
  pago_em        DateTime?
  observacao     String?
  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  clinica        Clinica      @relation(fields: [tenantId], references: [tenantId])
  createdAt      DateTime     @default(now())

  @@unique([tenantId, profissionalId, periodo])
  @@map("repasses_profissional")
}

model AiLog {
  id        String   @id @default(uuid())
  mensagem  String
  createdAt DateTime @default(now())

  @@map("ai_logs")
}

model InviteToken {
  id            String   @id @default(uuid())
  token         String   @unique
  email         String
  nome          String?
  role          String   @default("recepcao")
  especialidade String?
  tenantId      String
  convidadoPor  String?
  used          Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@map("invite_tokens")
}

model EmailVerificacao {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  usado     Boolean  @default(false)
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@map("email_verificacoes")
}

model SenhaReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  usado     Boolean  @default(false)
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@map("senha_resets")
}

model LoginLog {
  id        String   @id @default(cuid())
  email     String
  resultado String   // sucesso | credenciais_invalidas | email_nao_encontrado | acesso_expirado | google_erro | erro_interno
  detalhe   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("login_logs")
}

model Assinatura {
  id                 String    @id @default(uuid())
  tenantId           String    @unique
  stripeCustomerId   String?
  stripeSubId        String?
  plano              String    @default("trial") // trial, starter, pro, enterprise
  status             String    @default("trial") // trial, active, past_due, canceled, expired
  trialInicio        DateTime  @default(now())
  trialFim           DateTime?
  proximoVencimento  DateTime?
  valorMensal        Float?
  canceladoEm        DateTime?
  motivoCancelamento String?
  updatedAt          DateTime  @updatedAt

  @@map("assinaturas")
}

model Servico {
  id               String   @id @default(uuid())
  nome             String
  descricao        String?
  duracaoMinutos   Int      @default(30)
  bufferTimeMinutes Int     @default(0)
  preco            Float    @default(0.0)
  color            String?  @default("#3B82F6")
  nicho            String?
  ativo            Boolean  @default(true)
  tenantId         String
  clinica          Clinica  @relation(fields: [tenantId], references: [tenantId])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profissionais    Profissional[] // Many-to-many with professionals
  gatilhosUpsell   ComboUpsell[] @relation("GatilhoUpsell")
  ofertasUpsell    ComboUpsell[] @relation("OfertaUpsell")
  agendamentos     Agendamento[]
  tabelaPrecos     ConvenioTabelaPreco[]
  sugestoesProduto ServicoSugestao[]
  filaEspera       FilaEspera[]
  fichasTecnicas   InsumoFichaTecnica[]

  @@map("servicos")
}

model ComboUpsell {
  idItem               String   @id @default(uuid()) @map("id")
  tenantId             String
  servicoGatilhoId     String
  servicoOferecidoId   String
  descricaoOferta      String
  desconto             Float    @default(0.0)
  ativo                Boolean  @default(true)
  
  clinica              Clinica  @relation(fields: [tenantId], references: [tenantId])
  gatilho              Servico  @relation("GatilhoUpsell", fields: [servicoGatilhoId], references: [id])
  oferta               Servico  @relation("OfertaUpsell", fields: [servicoOferecidoId], references: [id])
  createdAt            DateTime @default(now())

  @@map("combos_upsell")
}

model CampanhaAviso {
  id                   String   @id @default(uuid())
  tenantId             String
  titulo               String
  mensagem             String
  segmentoFiltrosJson  String?  // JSON string
  dataEnvio            DateTime?
  status               String   @default("pendente") // rascunho, enviando, concluida, cancelado
  totalEnviado         Int      @default(0)
  totalErros           Int      @default(0)
  tipo                 String   @default("todos") // todos | aniversariantes | inativos | servico
  filtroServico        String?
  filtroInativoDias    Int?
  concluidoEm          DateTime?

  clinica              Clinica  @relation(fields: [tenantId], references: [tenantId])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("campanhas_aviso")
}

model Notificacao {
  id        String   @id @default(uuid())
  tenantId  String
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  clinica   Clinica  @relation(fields: [tenantId], references: [tenantId])
  createdAt DateTime @default(now())

  @@map("notificacoes")
}

model PlanoAssinatura {
  id            String   @id @default(cuid())
  empresaId     String
  nome          String   // ex: "Corte + Barba"
  descricao     String?
  valor         Float    // Usando Float para consistência com o restante do projeto
  periodicidade String   // "mensal" | "trimestral" | "anual"
  servicos      Json     // lista de serviços incluídos
  ativo         Boolean  @default(true)
  isTemplate    Boolean  @default(false)
  templateTipo  String?  // 'basico' | 'premium' | 'vip'
  stripePriceId String?
  agendamentoPrioritario Boolean @default(false)
  descontoProdutos       Float?
  descontoServicosExtras Float?
  tenantId    String
  clinica     Clinica  @relation(fields: [tenantId], references: [tenantId])
  assinantes  AssinaturaCliente[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("planos_assinatura")
}

model AssinaturaCliente {
  id               String   @id @default(cuid())
  pacienteId       String
  planoId          String
  dataInicio       DateTime @default(now())
  dataFim          DateTime?
  status           String   @default("ativo") // "ativo" | "cancelado" | "suspenso" | "expirado"
  valorPago        Float
  stripeSubId      String?
  stripeCustomerId String?
  proximaCobranca  DateTime?
  ultimaCobranca   DateTime?
  contadorUso      Json     @default("{}")
  periodoInicio    DateTime @default(now())
  periodoFim       DateTime?
  paciente         Paciente        @relation(fields: [pacienteId], references: [id])
  plano            PlanoAssinatura @relation(fields: [planoId], references: [id])
  tenantId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("assinaturas_cliente")
}

model ClinicIntegration {
  id                    String   @id @default(cuid())
  tenantId              String
  provider              String   // mercadopago, pagseguro, cielo, stripe_clinic
  encryptedCredentials  String
  isActive              Boolean  @default(true) // SOFT DELETE
  nomeExibicao          String?
  ultimoTeste           DateTime?
  erroDetalhe           String?
  clinica               Clinica  @relation(fields: [tenantId], references: [tenantId])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tenantId, provider])
  @@map("clinic_integrations")
}

enum WhatsappStatus {
  LIVRE
  EM_USO
  DEMO
  OFFLINE
  AGUARDANDO
}

enum StatusAgendamento {
  pendente
  confirmado
  em_atendimento
  done
  faltou
  cancelado
}

enum WhatsappPlataforma {
  WASENDERAPI
  ULTRAMSG
}

enum WhatsappMigrationStatus {
  TRIAL
  MIGRATING
  PRODUCTION
}

model WhatsappMigrationLog {
  id            String   @id @default(cuid())
  tenantId      String
  fromPlatform  WhatsappPlataforma?
  toPlatform    WhatsappPlataforma?
  fromSessionId String?
  toSessionId   String?
  status        String
  createdAt     DateTime @default(now())

  @@map("whatsapp_migration_logs")
}

model WhatsappInstance {
  id           String              @id @default(cuid())
  empresaId    String?
  sessionId    String              @unique
  bearerToken  String
  numeroWa     String?
  status       WhatsappStatus      @default(LIVRE)
  plataforma   WhatsappPlataforma  @default(WASENDERAPI)
  webhookUrl   String?
  observacoes  String?
  criadoEm     DateTime            @default(now())
  conectadoEm  DateTime?
  ultimoPing   DateTime?
  empresa      Clinica?            @relation(fields: [empresaId], references: [tenantId])

  @@map("whatsapp_instances")
}

// ─── Prontuário Digital ──────────────────────────────────────

model ProntuarioRegistro {
  id             String   @id @default(cuid())
  pacienteId     String
  tenantId       String
  profissionalId String?
  tipo           String   // CLINICO | ODONTOLOGICO | NUTRICIONAL
  agendamentoId  String?

  // Campos clínicos gerais
  queixaPrincipal     String?
  evolucao            String?   // texto livre da consulta (campo rico)
  historiaMolestia    String?
  historicoMedico     String?
  medicamentosUso     String?
  alergias            String?
  exameSolicitado     String?
  exameResultado      String?
  hipoteseDiagnostica String?
  conduta             String?
  retornoEm           DateTime?

  // CID-10
  cidCodigo    String?
  cidDescricao String?

  // Métricas vitais
  pressaoSistolica  Int?
  pressaoDiastolica Int?
  temperatura       Float?
  saturacao         Int?
  glicemia          Int?

  // Campos nutricionais
  historicoAlimentar  String?
  restricoes          String?
  objetivoPaciente    String?
  planoAlimentar      String?
  recordatorio24h     String?
  metas               String?

  // IA e Voz
  iaRascunho         String?
  iaPromptUsado      String?
  iaRevisado         Boolean  @default(false)
  transcricaoOriginal String?

  // SOAP
  soapSubjetivo String?
  soapObjetivo  String?
  soapAvaliacao String?
  soapPlano     String?

  // Assinatura Digital
  assinadoPor    String?
  assinadoEm    DateTime?
  assinaturaHash String?

  // Psicologia
  escalasAplicadas      Json?   // { phq9: {...}, gad7: {...} }
  objetivosTerapeuticos String?
  evolucaoPsico         String?

  // Estética
  protocoloEstetico String?
  regiaoTratada     String?
  produtosUsados    String?
  fotosAntesDep     Json?   // [{ antes: url, depois: url }]

  paciente     Paciente      @relation(fields: [pacienteId], references: [id])
  clinica      Clinica       @relation(fields: [tenantId], references: [tenantId])
  profissional Profissional? @relation(fields: [profissionalId], references: [id])
  medidas      MedidaCorporal[]
  odontograma  OdontogramaItem[]
  arquivos     ProntuarioArquivo[]
  cidsSugeridos CidSugerido[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("prontuario_registros")
}

model CidSugerido {
  id           String             @id @default(cuid())
  prontuarioId String
  codigo       String
  descricao    String
  relevancia   Float              @default(1.0)
  confirmado   Boolean            @default(false)
  prontuario   ProntuarioRegistro @relation(fields: [prontuarioId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@map("cids_sugeridos")
}

model ProntuarioArquivo {
  id          String             @id @default(cuid())
  evolutionId String
  pacienteId  String
  tenantId    String
  nome        String
  tipo        String             // EXAME | FOTO | DOCUMENTO | RECEITA | ATESTADO
  url         String?            // null após deleção LGPD
  descricao   String?
  iaResumo    String?            // Texto extraído pela IA — fica após deleção do arquivo
  deletarEm   DateTime?          // Prazo LGPD (48h após upload)
  deletado    Boolean            @default(false)
  consentimento Boolean          @default(false)
  evolution   ProntuarioRegistro @relation(fields: [evolutionId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())

  @@map("prontuario_arquivos")
}

model PacienteAlergia {
  id         String   @id @default(cuid())
  pacienteId String
  tenantId   String
  descricao  String
  gravidade  String   @default("MODERADA") // LEVE | MODERADA | GRAVE
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("paciente_alergias")
}

model PacienteMedicamento {
  id         String    @id @default(cuid())
  pacienteId String
  tenantId   String
  nome       String
  dosagem    String?
  frequencia String?
  uso        String    @default("CONTINUO") // CONTINUO | TEMPORARIO
  inicio     DateTime?
  fim        DateTime?
  ativo      Boolean   @default(true)
  paciente   Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("paciente_medicamentos")
}

model ProntuarioTemplate {
  id             String   @id @default(cuid())
  profissionalId String?
  tenantId       String
  nome           String
  especialidade  String?
  isGlobal       Boolean  @default(false) // templates padrão Synka
  campos         Json     // estrutura do template
  clinica        Clinica  @relation(fields: [tenantId], references: [tenantId])
  createdAt      DateTime @default(now())

  @@map("prontuario_templates")
}

model MedidaCorporal {
  id            String             @id @default(cuid())
  prontuarioId  String
  peso          Float?
  altura        Float?
  imc           Float?
  percGordura   Float?
  circAbdominal Float?
  circQuadril   Float?
  circBraco     Float?
  circCoxa      Float?
  prontuario    ProntuarioRegistro @relation(fields: [prontuarioId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@map("medidas_corporais")
}

enum StatusDente {
  HIGIDO
  CARIE
  RESTAURADO
  EXTRACAO_INDICADA
  EXTRAIDO
  COROA
  IMPLANTE
  CANAL
  FRATURA
}

model OdontogramaItem {
  id             String             @id @default(cuid())
  prontuarioId   String
  pacienteId     String
  tenantId       String
  numeroDente    Int                // 11 a 48 (ISO 3950)
  status         StatusDente        @default(HIGIDO)
  facesAfetadas  Json?              // ["mesial","distal","oclusal","vestibular","lingual"]
  observacao     String?
  atualizadoPor  String?
  prontuario     ProntuarioRegistro @relation(fields: [prontuarioId], references: [id], onDelete: Cascade)
  clinica        Clinica            @relation(fields: [tenantId], references: [tenantId])
  atualizadoEm   DateTime           @updatedAt
  createdAt      DateTime           @default(now())

  @@unique([prontuarioId, numeroDente])
  @@map("odontograma_itens")
}

// ─── Marketing / WhatsApp Automação ─────────────────────────────

model MarketingConfig {
  id                        String   @id @default(uuid())
  tenantId                  String   @unique
  wasenderApiKey            String?
  wasenderSessionId         String?
  lembreteAtivo             Boolean  @default(true)
  lembreteAntecedenciaHoras Int      @default(24)
  lembreteHorario           String   @default("09:00")
  lembreteTemplate          String?
  aniversarioAtivo          Boolean  @default(true)
  aniversarioHorario        String   @default("08:00")
  aniversarioDescontoPct    Int      @default(15)
  aniversarioTemplate       String?
  confirmacaoAtivo          Boolean  @default(true)
  confirmacaoTemplate       String?
  cancelamentoAtivo         Boolean  @default(true)
  cancelamentoTemplate      String?
  remarcacaoAtivo           Boolean  @default(true)
  remarcacaoTemplate        String?
  linkConfirmacao           String?
  nomeClinica               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("marketing_configs")
}

model MarketingCombo {
  id               String   @id @default(uuid())
  tenantId         String
  nome             String
  descricao        String?
  servicos         String[]
  gatilhoServico   String?
  precoOriginal    Decimal?  @db.Decimal(10,2)
  precoCombo       Decimal   @db.Decimal(10,2)
  descontoPct      Int?
  ativo            Boolean  @default(true)
  validadeDias     Int      @default(30)
  templateWhatsapp String?
  createdAt        DateTime @default(now())

  envios MarketingEnvio[]

  @@map("marketing_combos")
}

model MarketingEnvio {
  id               String    @id @default(uuid())
  tenantId         String
  tipo             String    // 'lembrete' | 'aniversario' | 'combo' | 'campanha'
  clienteNome      String?
  clienteTelefone  String
  mensagemEnviada  String?
  comboId          String?
  wasenderMsgId    String?
  status           String    @default("enviado") // 'enviado' | 'erro' | 'pendente'
  erroDetalhe      String?
  enviadoEm        DateTime  @default(now())

  combo MarketingCombo? @relation(fields: [comboId], references: [id])

  @@map("marketing_envios")
}

model MarketingCampanha {
  id                  String    @id @default(uuid())
  tenantId            String
  nome                String
  tipo                String?   // 'todos' | 'aniversariantes' | 'inativos' | 'servico'
  filtroServico       String?
  filtroInativoDias   Int?
  template            String
  totalDestinatarios  Int       @default(0)
  totalEnviados       Int       @default(0)
  totalErros          Int       @default(0)
  status              String    @default("rascunho")
  agendadoPara        DateTime?
  criadoEm            DateTime  @default(now())
  concluidoEm         DateTime?

  @@map("marketing_campanhas")
}

// ─── Permissões Granulares por Role ──────────────────────────────

model PermissaoRole {
  id       String  @id @default(uuid())
  tenantId String
  role     String  // admin | recepcao | profissional
  recurso  String  // agenda | pacientes | financeiro | relatorios | prontuario | equipe | marketing | configuracoes
  acao     String  // ver | criar | editar | deletar
  ativo    Boolean @default(true)
  clinica  Clinica @relation(fields: [tenantId], references: [tenantId])

  @@unique([tenantId, role, recurso, acao])
  @@map("permissoes_role")
}

// Histórico de alterações do odontograma
model OdontogramaHistorico {
  id            String      @id @default(cuid())
  numeroDente   Int
  statusAnterior StatusDente?
  statusNovo    StatusDente
  observacao    String?
  alteradoPor   String?
  tenantId      String
  pacienteId    String
  clinica       Clinica     @relation(fields: [tenantId], references: [tenantId])
  createdAt     DateTime    @default(now())

  @@map("odontograma_historico")
}

// ─── Ficha do Cliente — Nichos de Beleza ─────────────────────────────────────

model FichaCliente {
  id          String   @id @default(cuid())
  pacienteId  String   @unique
  tenantId    String
  nicho       String   // BARBEARIA | SALAO_BELEZA | CLINICA_ESTETICA

  // Comum a todos
  profissionalPreferidoId String?
  observacoesGerais       String?
  alertas                 String?
  produtosFavoritos       String?

  // BARBEARIA
  estiloPreferido  String?
  maquinaNumero    String?
  barbaEstilo      String?
  produtoBarba     String?

  // SALÃO DE BELEZA
  tipoCabelo         String?
  porosidade         String?
  coloracaoAtual     String?
  historicoColoracao String?
  ultimaQuimica      DateTime?
  tipoQuimica        String?
  produtosUsados     String?
  reacoesProdutos    String?

  // CLÍNICA ESTÉTICA
  tipoPele             String?
  fitzpatrick          String?
  patologiasPele       String?
  medicamentosUso      String?
  alergiasSubstancias  String?
  protocolosRealizados String?
  resultadosEvolucao   String?
  ultimaLimpezaPele    DateTime?

  paciente  Paciente       @relation(fields: [pacienteId], references: [id])
  clinica   Clinica        @relation(fields: [tenantId], references: [tenantId])
  fotos     FotoCliente[]
  visitas   VisitaCliente[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("fichas_cliente")
}

model FotoCliente {
  id               String       @id @default(cuid())
  fichaId          String
  tenantId         String
  pacienteId       String
  tipo             String       // antes | depois | referencia | evolucao
  urlArquivo       String       @db.Text
  descricao        String?
  servicoNome      String?
  profissionalNome String?
  deletarEm        DateTime?
  deletado         Boolean      @default(false)
  ficha            FichaCliente @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@map("fotos_cliente")
}

model VisitaCliente {
  id               String       @id @default(cuid())
  fichaId          String
  pacienteId       String
  tenantId         String
  agendamentoId    String?
  servicoNome      String
  profissionalNome String?
  valor            Float?
  observacoes      String?
  satisfacao       Int?
  fotosIds         String[]
  ficha            FichaCliente @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@map("visitas_cliente")
}

// ─── Módulo Vitrine ──────────────────────────────────────────────

model CategoriaProduto {
  id        String    @id @default(uuid())
  tenantId  String
  nome      String
  clinica   Clinica   @relation(fields: [tenantId], references: [tenantId])
  produtos  Produto[]
  createdAt DateTime  @default(now())

  @@map("categorias_produto")
}

model Produto {
  id             String            @id @default(uuid())
  tenantId       String
  categoriaId    String?
  nome           String
  descricao      String?
  dicaDeUso      String?
  preco          Float             @default(0.0)
  imageUrl       String?           @db.Text
  estoque        Float             @default(0)    // Float para suportar ml/g
  estoqueMinimo  Float             @default(0)    // alerta de ruptura 
  status         String            @default("active")  // active | inactive
  tipo           String            @default("venda")   // venda | insumo | ambos
  unidade        String            @default("un")      // un | ml | g | l | kg
  custoUnitario  Float             @default(0.0)
  dataEntrada    DateTime?
  dataValidade   DateTime?
  tags           String[]
  fabricante     String?
  posicionamento String?
  clinica        Clinica           @relation(fields: [tenantId], references: [tenantId])
  categoria      CategoriaProduto? @relation(fields: [categoriaId], references: [id])
  comboItens     ComboItemVitrine[]
  sugestoes      ServicoSugestao[]
  pedidoItens    PedidoItem[]
  fichasTecnicas InsumoFichaTecnica[]
  movimentacoes  MovimentacaoEstoque[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("produtos")
}

model ComboProduto {
  id          String             @id @default(uuid())
  tenantId    String
  nome        String
  preco       Float
  desconto    Float              @default(0.0)
  status      String             @default("active") // active | inactive
  clinica     Clinica            @relation(fields: [tenantId], references: [tenantId])
  itens       ComboItemVitrine[]
  pedidoItens PedidoItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("combos_produto")
}

model ComboItemVitrine {
  id        String       @id @default(uuid())
  comboId   String
  produtoId String
  combo     ComboProduto @relation(fields: [comboId], references: [id], onDelete: Cascade)
  produto   Produto      @relation(fields: [produtoId], references: [id])

  @@unique([comboId, produtoId])
  @@map("combo_itens_vitrine")
}

model ServicoSugestao {
  id        String  @id @default(uuid())
  tenantId  String
  servicoId String
  produtoId String
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([servicoId, produtoId])
  @@map("servico_sugestoes")
}

model PedidoItem {
  id              String        @id @default(uuid())
  tenantId        String
  agendamentoId   String?
  pacienteId      String?
  produtoId       String?
  comboId         String?
  quantidade      Int           @default(1)
  precoUnitario   Float
  status          String        @default("reserved") // reserved | paid_online | paid_presential | cancelled
  paymentIntentId String?
  clinica         Clinica       @relation(fields: [tenantId], references: [tenantId])
  agendamento     Agendamento?  @relation(fields: [agendamentoId], references: [id])
  produto         Produto?      @relation(fields: [produtoId], references: [id])
  combo           ComboProduto? @relation(fields: [comboId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("pedido_itens")
}

model MasterProduct {
  id             String   @id @default(uuid())
  nicho          String?
  fabricante     String?
  categoria      String?
  nome           String
  descricao      String?  @db.Text
  dicaUso        String?  @db.Text
  tags           String[]
  posicionamento String?
  imageUrl       String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("master_products")
}

// ─── Módulo Antes e Depois ──────────────────────────────────────

model ConsentimentoImagem {
  id              String   @id @default(cuid())
  tenantId        String
  pacienteId      String
  profissionalId  String
  nomeCliente     String
  cpfCliente      String?
  termoVersao     String   @default("v1.0")
  termoHash       String
  ipDispositivo   String?
  userAgent       String?
  tipoAssinatura  String
  assinaturaImg   String?
  aceito          Boolean  @default(false)
  aceitoEm        DateTime @default(now())
  revogado        Boolean  @default(false)
  revogadoEm      DateTime?

  paciente     Paciente     @relation(fields: [pacienteId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])
  clinica      Clinica      @relation(fields: [tenantId], references: [tenantId])
  resultados   ResultadoAntesDepois[]

  @@map("consentimentos_imagem")
}

model ResultadoAntesDepois {
  id               String   @id @default(cuid())
  tenantId         String
  pacienteId       String
  profissionalId   String
  consentimentoId  String
  fotoAntesUrl     String
  fotoDepoisUrl    String
  procedimento     String
  periodoTratamento String
  dataAntes        DateTime
  dataDepois       DateTime @default(now())
  laudoIA          String
  laudoEditado     String?
  laudoValidado    Boolean  @default(false)
  laudoValidadoEm  DateTime?
  assinaturaProfissional String?
  assinadoEm       DateTime?
  slugPublico      String   @unique
  publicado        Boolean  @default(false)
  publicadoEm      DateTime?
  expirarEm        DateTime?
  totalVisualizacoes Int    @default(0)
  totalCompartilhamentos Int @default(0)
  imagemPngUrl     String?
  imagemGeradaEm   DateTime?
  imagemExpirarEm  DateTime?
  videoMp4Url      String?
  videoGeradoEm    DateTime?
  videoExpirarEm   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consentimento ConsentimentoImagem  @relation(fields: [consentimentoId], references: [id])
  paciente      Paciente     @relation(fields: [pacienteId], references: [id])
  profissional  Profissional @relation(fields: [profissionalId], references: [id])
  clinica       Clinica      @relation(fields: [tenantId], references: [tenantId])

  @@map("resultados_antes_depois")
}

model FilaEspera {
  id              String    @id @default(cuid())
  tenantId        String
  pacienteId      String
  profissionalId  String?
  servicoId       String
  dataDesejada    DateTime
  horarioDesejado String?
  preferencia     String    @default("qualquer") // manha|tarde|qualquer
  prioridade      Int       @default(0)           // assinante=1, normal=0
  posicao         Int
  status          String    @default("aguardando") // aguardando|notificado|expirado|convertido|cancelado
  notificadoEm    DateTime?
  expirarNotifEm  DateTime?

  paciente     Paciente      @relation(fields: [pacienteId], references: [id])
  profissional Profissional? @relation(fields: [profissionalId], references: [id])
  servico      Servico       @relation(fields: [servicoId], references: [id])
  clinica      Clinica       @relation(fields: [tenantId], references: [tenantId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([profissionalId, dataDesejada, status])
  @@map("fila_espera")
}

// ─── Módulo de Insumos ───────────────────────────────────────────────────────

// Ficha técnica: quanto de cada insumo um serviço consome por atendimento
model InsumoFichaTecnica {
  id              String      @id @default(uuid())
  tenantId        String
  servicoId       String
  produtoId       String
  quantidadeEst   Float       // consumo estimado por atendimento
  quantidadeReal  Float?      // média calculada automaticamente
  unidade         String      @default("un") // referência à unidade do produto

  clinica         Clinica     @relation(fields: [tenantId], references: [tenantId])
  servico         Servico     @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  produto         Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([servicoId, produtoId])
  @@index([tenantId])
  @@map("insumo_ficha_tecnica")
}

// Histórico completo de movimentações de estoque (entradas, baixas, ajustes)
model MovimentacaoEstoque {
  id              String        @id @default(uuid())
  tenantId        String
  produtoId       String
  tipo            String        // entrada | baixa_auto | baixa_manual | ajuste | vencimento
  quantidade      Float         // negativo para baixa, positivo para entrada
  saldoAntes      Float
  saldoDepois     Float
  agendamentoId   String?
  profissionalId  String?
  observacao      String?

  clinica         Clinica       @relation(fields: [tenantId], references: [tenantId])
  produto         Produto       @relation(fields: [produtoId], references: [id])
  agendamento     Agendamento?  @relation(fields: [agendamentoId], references: [id])
  profissional    Profissional? @relation(fields: [profissionalId], references: [id])

  createdAt       DateTime      @default(now())

  @@index([tenantId, produtoId])
  @@index([tenantId, createdAt])
  @@map("movimentacoes_estoque")
}

// ─── Convites de usuário ──────────────────────────────────────────────────────

model Convite {
  id             String    @id @default(cuid())
  tenantId       String
  email          String?
  telefone       String?
  nome           String
  role           String    // admin | recepcao | profissional
  profissionalId String?
  token          String    @unique @default(cuid())
  status         String    @default("pendente") // pendente | aceito | expirado | cancelado
  criadoPor      String    // userId do admin
  expirarEm      DateTime
  aceitoEm       DateTime?

  clinica        Clinica   @relation(fields: [tenantId], references: [tenantId])

  createdAt      DateTime  @default(now())

  @@index([tenantId, status])
  @@map("convites")
}

// ─── Dias Bloqueados / Feriados ───────────────────────────────────────────────

model DiaBloqueado {
  id            String    @id @default(uuid())
  tenantId      String
  data          DateTime  // dia do fechamento (a hora é irrelevante; usa-se só a data)
  titulo        String    @default("Feriado")
  mensagem      String    // ex: "Hoje não estamos funcionando. Voltamos dia 21/04 às 08h 🙏"
  retornoData   DateTime? // data de retorno (opcional)
  retornoHora   String?   // ex: "08:00"
  ativo         Boolean   @default(true)
  clinica       Clinica   @relation(fields: [tenantId], references: [tenantId])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, data, ativo])
  @@map("dias_bloqueados")
}

model PixConfig {
  id             String  @id @default(cuid())
  tenantId       String  @unique
  ativo          Boolean @default(false)
  tipoChave      String  // 'cpf'|'cnpj'|'email'|'telefone'|'aleatoria'
  chave          String
  nomeFavorecido String
  banco          String?
  exibirNoLink   Boolean @default(true)  // link publico
  exibirNoWpp    Boolean @default(true)  // bot whatsapp
  mensagemPix    String? // texto personalizado
  
  clinica Clinica @relation(fields: [tenantId], references: [tenantId])
  updatedAt DateTime @updatedAt

  @@map("pix_configs")
}

// ─── Resumo Diário / Semanal ──────────────────────────────────────────────────

model ResumoConfig {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  ativo                Boolean  @default(true)
  frequencia           String   @default("diario")   // "diario" | "semanal"
  horaDiario           String   @default("07:00")
  diaSemana            String   @default("segunda")  // segunda..domingo
  horaSemanal          String   @default("07:00")
  recebeAdmin          Boolean  @default(true)
  recebeRecepcao       Boolean  @default(false)
  recebeProfissional   Boolean  @default(false)
  secaoAgenda          Boolean  @default(true)
  secaoOcupacao        Boolean  @default(true)
  secaoFinanceiro      Boolean  @default(true)
  secaoEstoque         Boolean  @default(true)
  secaoFilaEspera      Boolean  @default(true)
  secaoInsightsIA      Boolean  @default(true)
  estoqueMinimo        Int      @default(3)
  clinica              Clinica  @relation(fields: [tenantId], references: [tenantId])
  updatedAt            DateTime @updatedAt

  @@map("resumo_configs")
}

// ─── Notificações Internas ────────────────────────────────────────────────────

model NotificacaoInterna {
  id        String   @id @default(cuid())
  tenantId  String
  usuarioId String
  tipo      String   // "resumo" | "alerta" | "sistema"
  titulo    String
  conteudo  String   @db.Text
  lida      Boolean  @default(false)
  lidaEm   DateTime?
  createdAt DateTime @default(now())

  usuario  Usuario @relation(fields: [usuarioId], references: [id])
  clinica  Clinica @relation(fields: [tenantId], references: [tenantId])

  @@index([usuarioId, lida])
  @@map("notificacoes_internas")
}

// ─── Estado de Conversa WhatsApp Bot ─────────────────────────────────────────

model ConversaEstado {
  id        String   @id @default(cuid())
  telefone  String
  tenantId  String
  etapa     String
  dados     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([telefone, tenantId])
  @@map("conversa_estados")
}
